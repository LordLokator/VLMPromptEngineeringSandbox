# Copy to `.env` (git-ignored) next to main.py and uncomment what you need. Everything is optional: with nothing set,
# the app runs two demo agents. A variable set in the real environment wins over `.env`, even when empty; an empty
# value counts as unset. Each setting is described in README.md, Configuration.

# --- Agents at startup: `provider` or `provider:model` (demo, openai, anthropic, ollama, compat, hf) ---
# VLM_AGENT_A=openai:gpt-5.4-mini
# VLM_AGENT_B=anthropic:claude-haiku-5-5

# --- Provider keys and URLs (remote providers are paid per call) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
# VLM_COMPAT_BASE_URL=
# VLM_COMPAT_API_KEY=

# --- Local VideoLLaMA3-7B (needs a CUDA GPU and the `gpu` extra) ---
# VLM_ENABLE_HF=1
# VLM_ATTN_IMPL=flash_attention_2

# --- Server ---
# VLM_HOST=127.0.0.1
# VLM_PORT=8000
# VLM_ALLOWED_HOSTS=
# VLM_ALLOW_REMOTE_PAID=0

# --- OpenTelemetry (needs the `otel` extra) ---
# OTEL_ENABLED=1
# OTEL_TRACES_EXPORTER=console
# OTEL_METRICS_EXPORTER=console
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
